#  MAIN LOOP
# ═══════════════════════════════════════════════════════════════
def main(scr):
    _init_colors()
    curses.curs_set(0)
    scr.nodelay(True)

    state    = State()
    renderer = Renderer(scr, state)
    interval = 1.0 / CONFIG["fps"]
    last_t   = time.monotonic()

    while True:
        try:
            key = scr.getch()
        except curses.error:
            key = -1

        s = state

        # ── global keys ──────────────────────────────────────
        if key in (ord('q'), ord('Q'), 27):       # quit / ESC
            break
        elif key in (ord('?'), ord('H')):          # help toggle
            s.view = "help" if s.view != "help" else "dash"
        elif key in (ord('d'), ord('D')):          # dashboard
            s.view = "dash"
        elif key in (ord('c'), ord('C')):          # chat
            s.view = "chat"
        elif key in (ord('p'), ord('P'), ord(' ')):# pause
            s.paused = not s.paused
        elif key in (ord('r'), ord('R')):          # reset
            s.phi = 0.680; s.q_val = 0.724
            s.d_val = 0.451; s.v_val = 4.83
        elif key in (ord('s'), ord('S')):          # swap regime
            s.next_regime()
        elif key == curses.KEY_UP:
            s.log_scroll = min(len(s.log) - 1, s.log_scroll + 1)
        elif key == curses.KEY_DOWN:
            s.log_scroll = max(0, s.log_scroll - 1)
        elif key == curses.KEY_PPAGE:
            s.log_scroll = min(len(s.log) - 1, s.log_scroll + 10)
        elif key == curses.KEY_NPAGE:
            s.log_scroll = max(0, s.log_scroll - 10)
        elif key == curses.KEY_RESIZE:
            s.matrix.clear()

        # ── chat input keys ──────────────────────────────────
        if s.view == "chat":
            if key == curses.KEY_ENTER or key == 10 or key == 13:
                s.send_chat()
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                s.chat_input = s.chat_input[:-1]
            elif 32 <= key < 127:
                s.chat_input += chr(key)

        # ── update + render ──────────────────────────────────
        now = time.monotonic()
        if now - last_t >= interval:
            last_t = now
            state.update()
            renderer.draw()

        time.sleep(0.001)


