class Renderer:
    def __init__(self, scr, state):
        self.scr   = scr
        self.state = state
        self.h     = 0
        self.w     = 0

    # ── safe addstr / addch ─────────────────────────────────────
    def _put(self, y, x, text, attr=0):
        if y < 0 or y >= self.h or x >= self.w:
            return
        if x < 0:
            text = text[-x:]
            x = 0
        clip = self.w - x - 1
        if clip <= 0:
            return
        try:
            self.scr.addstr(y, x, text[:clip], attr)
        except curses.error:
            pass

    def _putch(self, y, x, ch, attr=0):
        if 0 <= y < self.h and 0 <= x < self.w - 1:
            try:
                self.scr.addch(y, x, ch, attr)
            except curses.error:
                pass

    # ── main draw entry ─────────────────────────────────────────
    def draw(self):
        self.h, self.w = self.scr.getmaxyx()
        s = self.state
        self.scr.erase()

        if s.view == "help":
            self._draw_help()
        elif s.view == "chat":
            self._draw_chat_view()
        else:
            self._draw_dashboard()

        self.scr.refresh()

    # ── outer box ───────────────────────────────────────────────
    def _outer_box(self):
        try:
            self.scr.box()
        except curses.error:
            pass
        title = f"  {APP_NAME} {VERSION}  "
        tx = max(2, (self.w - len(title)) // 2)
        self._put(0, tx, title, curses.color_pair(CP.CYAN) | curses.A_BOLD)

    # ── divider ─────────────────────────────────────────────────
    def _hline(self, y, label=""):
        if y <= 0 or y >= self.h - 1:
            return
        try:
            self.scr.hline(y, 1, curses.ACS_HLINE, self.w - 2,
                           curses.color_pair(CP.BORDER))
            self.scr.addch(y, 0, curses.ACS_LTEE,
                           curses.color_pair(CP.BORDER))
            self.scr.addch(y, self.w - 1, curses.ACS_RTEE,
                           curses.color_pair(CP.BORDER))
        except curses.error:
            pass
        if label:
            self._put(y, 3, f" {label} ", curses.color_pair(CP.DIM))

    # ── banner ──────────────────────────────────────────────────
    def _banner(self):
        if self.w >= 90:
            lines = BANNER_WIDE
        elif self.w >= 58:
            lines = BANNER_COMPACT
        else:
            lines = [APP_NAME]

        phase = self.state.wave_phase
        for row, line in enumerate(lines):
            cx = max(1, (self.w - len(line)) // 2)
            for ci, ch in enumerate(line):
                if cx + ci >= self.w - 1:
                    break
                # wave colour per character
                wave = math.sin(phase + ci * 0.10 + row * 0.45)
                ci2  = int((wave + 1) / 2 * (len(WAVE_CP) - 1))
                cp   = WAVE_CP[ci2 % len(WAVE_CP)]
                attr = curses.color_pair(cp)
                if ch not in (' ', '\t'):
                    attr |= curses.A_BOLD
                self._putch(row + 1, cx + ci, ch, attr)

        # subtitle
        bh = len(lines) + 1
        sub = SUBTITLE if self.w >= len(SUBTITLE) + 4 else "ADAPTIVE REGIME OPTIMIZATION  ·  STORM SWARM AIOS"
        if self.w < len(sub) + 4:
            sub = "CODEBASE ANALYSIS ENGINE"
        sx = max(1, (self.w - len(sub)) // 2)
        self._put(bh, sx, sub, curses.color_pair(CP.DIM))
        return bh + 1   # return first row after banner

    # ── matrix rain ─────────────────────────────────────────────
    def _matrix(self, top, bot):
        s = self.state
        h = bot - top
        # spawn new drops
        for col in range(1, self.w - 1):
            if col not in s.matrix:
                if random.random() < CONFIG["matrix_density"] * 0.04:
                    s.matrix[col] = [
                        random.randint(top, top + h),
                        random.randint(3, 12),
                        random.uniform(0.4, 1.2),
                        0.0,
                    ]

        for col in list(s.matrix.keys()):
            entry = s.matrix[col]
            head, trail, speed, acc = entry
            acc += speed * 0.05
            if acc >= 1.0:
                acc -= 1.0
                head += 1
                s.matrix[col] = [head, trail, speed, acc]
                if head - trail > bot:
                    del s.matrix[col]
                    continue
            else:
                s.matrix[col][3] = acc

            for row in range(max(top, head - trail), min(bot, head + 1)):
                dist = head - row
                ch   = random.choice(MATRIX_CH)
                if dist == 0:
                    attr = curses.color_pair(CP.WHITE) | curses.A_BOLD
                elif dist <= 2:
                    attr = curses.color_pair(CP.MAT_HI) | curses.A_BOLD
                elif dist <= 6:
                    attr = curses.color_pair(CP.MAT_HI)
                else:
                    attr = curses.color_pair(CP.DIM)
                self._putch(row, col, ch, attr)

    # ── spinner char ────────────────────────────────────────────
    def _spin(self, angle):
        idx = int(angle / math.tau * len(SPINNER)) % len(SPINNER)
        return SPINNER[idx]

    # ── agents panel ────────────────────────────────────────────
    def _agents(self, y, x, h, w):
        s = self.state
        self._put(y, x, "AGENTS", curses.color_pair(CP.CYAN) | curses.A_BOLD | curses.A_UNDERLINE)
        for i, (name, desc) in enumerate(AGENTS):
            row = y + 2 + i
            if row >= y + h - 1:
                break
            spin = self._spin(s.agent_angle[i])
            # occasional pulse highlight
            if s.tick % (41 + i * 7) < 3:
                attr = curses.color_pair(CP.YELLOW) | curses.A_BOLD
            else:
                attr = curses.color_pair(CP.GREEN)
            short = name.replace("Agent", "").strip()
            label = f" {spin} {short:<12}"[:w - 1]
            self._put(row, x, label, attr)

        sep_y = y + 2 + len(AGENTS) + 1
        if sep_y < y + h:
            self._put(sep_y, x, "─" * min(w, self.w - x - 1), curses.color_pair(CP.BORDER))
        if sep_y + 1 < y + h:
            a1, a2, a3 = s.regime_coeffs
            self._put(sep_y + 1, x, f" Regime:", curses.color_pair(CP.DIM))
            self._put(sep_y + 1, x + 8, f"{s.regime}",
                      curses.color_pair(CP.YELLOW) | curses.A_BOLD)
        if sep_y + 2 < y + h:
            a1, a2, a3 = s.regime_coeffs
            self._put(sep_y + 2, x,
                      f" α₁={a1:.1f} α₂={a2:.1f} α₃={a3:.1f}",
                      curses.color_pair(CP.DIM))

    # ── bar helper ───────────────────────────────────────────────
    def _bar(self, val, w, col):
        pct    = max(0.0, min(1.0, val))
        filled = int(pct * w)
        bar    = "█" * filled + "░" * (w - filled)
        return bar, curses.color_pair(col)

    # ── metrics panel ────────────────────────────────────────────
    def _metrics(self, y, x, h, w):
        s = self.state
        self._put(y, x, "METRICS", curses.color_pair(CP.CYAN) | curses.A_BOLD | curses.A_UNDERLINE)

        bar_w = max(4, w - 12)

        def mrow(row, label, val, maxv, col, fmt=".3f"):
            if row >= y + h:
                return
            pct = val / maxv
            bar, battr = self._bar(pct, bar_w, col)
            self._put(row, x, f" {label:<5}", curses.color_pair(CP.DIM))
            self._put(row, x + 6, bar, battr)
            self._put(row, x + 6 + bar_w + 1,
                      format(val, fmt), curses.color_pair(CP.WHITE))

        mrow(y + 2, "Φ(G)", s.phi,   1.0, CP.CYAN)
        mrow(y + 3, "Q",    s.q_val, 1.0, CP.GREEN)
        mrow(y + 4, "D",    s.d_val, 1.0, CP.YELLOW)
        mrow(y + 5, "V",    s.v_val, 20., CP.RED2, ".1f")

        # pulsing big Φ box
        phi_y = y + 7
        if phi_y + 4 < y + h:
            pval  = f"{s.phi:.4f}"
            box_w = len(pval) + 6
            bx    = x + max(0, (w - box_w) // 2)
            pulse = math.sin(time.monotonic() * 2.5)
            attr  = (curses.color_pair(CP.CYAN) | curses.A_BOLD
                     if pulse > 0 else curses.color_pair(CP.CYAN))
            self._put(phi_y,     bx, "┌" + "─" * (box_w - 2) + "┐",
                      curses.color_pair(CP.BORDER))
            self._put(phi_y + 1, bx, f"│  Φ = {pval}  │", attr)
            self._put(phi_y + 2, bx, "└" + "─" * (box_w - 2) + "┘",
                      curses.color_pair(CP.BORDER))

        if phi_y + 3 < y + h:
            hist   = list(s.phi_history)
            trend  = (hist[-1] - hist[-6]) if len(hist) >= 6 else 0.0
            arrow  = "↑" if trend > 0.004 else ("↓" if trend < -0.004 else "─")
            acol   = CP.GREEN if trend > 0.004 else (CP.RED2 if trend < -0.004 else CP.YELLOW)
            self._put(phi_y + 3, x,
                      f"  trend: {arrow}  ({trend:+.4f})",
                      curses.color_pair(acol))

        # regime coefficients mini-display
        if phi_y + 5 < y + h:
            a1, a2, a3 = s.regime_coeffs
            self._put(phi_y + 5, x,
                      f"  α₁={a1:.1f}·Q  α₂={a2:.1f}·D  α₃={a3:.1f}·V",
                      curses.color_pair(CP.DIM))

    # ── log panel ────────────────────────────────────────────────
    def _log(self, y, x, h, w):
        s = self.state
        self._put(y, x, "ACTIVITY LOG", curses.color_pair(CP.CYAN) | curses.A_BOLD | curses.A_UNDERLINE)
        tag_cp = {"OK": CP.GREEN, "INFO": CP.WHITE, "WARN": CP.YELLOW, "ERR": CP.RED2}
        entries = list(s.log)
        start   = max(0, s.log_scroll)
        shown   = entries[start:start + (h - 2)]
        for i, (ts, tag, msg) in enumerate(shown):
            row = y + 2 + i
            if row >= y + h:
                break
            tc  = tag_cp.get(tag, CP.WHITE)
            t   = f"{ts} "
            tg  = f"[{tag:<4}] "
            avail = w - len(t) - len(tg) - 1
            self._put(row, x, t, curses.color_pair(CP.DIM))
            self._put(row, x + len(t), tg,
                      curses.color_pair(tc) | curses.A_BOLD)
            self._put(row, x + len(t) + len(tg),
                      msg[:max(0, avail)], curses.color_pair(CP.WHITE))

    # ── sparkline ────────────────────────────────────────────────
    def _sparkline(self, y):
        s    = self.state
        w    = self.w - 2
        hist = list(s.phi_history)
        if not hist:
            return
        n       = min(len(hist), w - 30)
        step    = len(hist) / max(n, 1)
        samples = [hist[int(i * step)] for i in range(n)]
        lo, hi  = min(samples), max(samples)
        rng     = hi - lo if hi != lo else 0.001
        spark   = "".join(
            SPARK[max(0, min(len(SPARK) - 1, int((v - lo) / rng * (len(SPARK) - 1))))]
            for v in samples)
        if s.phi > 0.75:
            attr = curses.color_pair(CP.GREEN) | curses.A_BOLD
        elif s.phi > 0.55:
            attr = curses.color_pair(CP.YELLOW)
        else:
            attr = curses.color_pair(CP.RED2)
        self._put(y, 1, spark, attr)
        meta = f" min:{lo:.3f} max:{hi:.3f} now:{s.phi:.4f} "
        self._put(y, self.w - len(meta) - 1, meta, curses.color_pair(CP.DIM))

    # ── status bar ───────────────────────────────────────────────
    def _statusbar(self, y):
        s   = self.state
        now = datetime.now().strftime("%H:%M:%S")
        psd = " [PAUSED]" if s.paused else ""
        eng = " [ENGINE]" if _ENGINE_AVAILABLE else ""
        lft = f"  q=quit  d=dash  c=chat  ?=help  s=regime({s.regime})  p=pause{psd}{eng}"
        rgt = f"Up:{s.uptime}  {now}  "
        gap = max(0, self.w - len(lft) - len(rgt))
        self._put(y, 0, lft, curses.color_pair(CP.DIM))
        self._put(y, self.w - len(rgt), rgt, curses.color_pair(CP.DIM))

    # ── DASHBOARD view ───────────────────────────────────────────
    def _draw_dashboard(self):
        s = self.state
        self._outer_box()
        bh = self._banner()           # returns first row after banner
        self._hline(bh, "Φ(G) SPARKLINE")
        self._sparkline(bh + 1)
        content_y = bh + 3
        self._hline(content_y - 1)

        # panel widths
        left_w   = max(20, self.w // 4)
        right_w  = max(28, self.w // 3)
        center_w = max(18, self.w - left_w - right_w - 4)
        panel_h  = max(5, self.h - content_y - 3)

        ax = 1
        bx = ax + left_w + 1
        cx = bx + center_w + 1

        # matrix rain in background
        self._matrix(content_y, content_y + panel_h)

        # vertical dividers
        for row in range(content_y, content_y + panel_h):
            self._putch(row, bx - 1, "│", curses.color_pair(CP.BORDER))
            self._putch(row, cx - 1, "│", curses.color_pair(CP.BORDER))

        # three panels (painted over matrix)
        self._agents( content_y, ax, panel_h, left_w)
        self._metrics(content_y, bx, panel_h, center_w)
        self._log(    content_y, cx, panel_h, right_w)

        self._hline(self.h - 2)
        self._statusbar(self.h - 2)

    # ── CHAT view ────────────────────────────────────────────────
    def _draw_chat_view(self):
        s = self.state
        self._outer_box()
        bh = self._banner()
        self._hline(bh, "CHAT · Codebase Analysis Engine · Adaptive Regime Optimization")

        chat_y  = bh + 2
        input_y = self.h - 3
        log_h   = input_y - chat_y
        w       = self.w - 2

        # chat history
        msgs  = list(s.chat)
        # wrap each message
        lines = []
        for (who, txt) in msgs:
            prefix = "YOU › " if who == "you" else "AI  › "
            col    = CP.YELLOW if who == "you" else CP.GREEN
            wrapped = []
            max_len = w - len(prefix) - 1
            while txt:
                wrapped.append(txt[:max_len])
                txt = txt[max_len:]
                if txt:
                    prefix2 = " " * len(prefix)
                    lines.append((prefix2, txt[:max_len], col))
                    txt = txt[max_len:]
            if wrapped:
                lines.append((prefix, wrapped[0], col))
                for ln in wrapped[1:]:
                    lines.append((" " * len(prefix), ln, col))

        # show last log_h lines
        visible = lines[-log_h:] if len(lines) > log_h else lines
        for i, (pre, txt, col) in enumerate(visible):
            row = chat_y + i
            if row >= input_y:
                break
            self._put(row, 1, pre, curses.color_pair(col) | curses.A_BOLD)
            self._put(row, 1 + len(pre), txt, curses.color_pair(CP.WHITE))

        # input box
        self._hline(input_y - 1)
        prompt = f" › {s.chat_input}"
        cursor = "█" if s.tick % 20 < 10 else " "
        self._put(input_y, 1, prompt + cursor,
                  curses.color_pair(CP.CYAN) | curses.A_BOLD)

        self._hline(self.h - 2)
        self._statusbar(self.h - 2)

    # ── HELP view ────────────────────────────────────────────────
    def _draw_help(self):
        self._outer_box()
        lines = [
            f"  HIGH-AGENTS {VERSION} — Keyboard Reference",
            "",
            "  KEY BINDINGS",
            "  ───────────────────────────────────────────",
            "  q / ESC     quit",
            "  d           dashboard view",
            "  c           chat view  (Codebase Analysis Engine)",
            "  ?           toggle this help",
            "  p / SPACE   pause / resume live updates",
            "  r           reset metrics",
            "  s           cycle to next regime",
            "  ↑ / ↓       scroll activity log",
            "  PgUp/PgDn   scroll log by page",
            "  Enter       send chat message",
            "  Backspace   delete chat character",
            "",
            "  CHAT SKILL: Codebase Analysis Engine",
            "  ───────────────────────────────────────────",
            "  Ask about: phi  q  d  v  regime  swarm  agent",
            "             skill  crawl  graph  status  version",
            "",
            "  EASY CUSTOMISATION",
            "  ───────────────────────────────────────────",
            "  · Edit AGENTS list    → change the swarm roster",
            "  · Edit LOG_EVENTS     → change activity messages",
            "  · Edit CONFIG dict    → change speeds/density",
            "  · Edit _chat_respond()→ extend the chat engine",
            "",
            "  Press ?  or  d  to return to dashboard.",
        ]
        top = max(1, (self.h - len(lines)) // 2)
        bw  = min(self.w - 4, 56)
        lx  = max(1, (self.w - bw) // 2)
        for i, line in enumerate(lines):
            row  = top + i
            if row <= 0 or row >= self.h - 1:
                continue
            attr = (curses.color_pair(CP.CYAN) | curses.A_BOLD
                    if i == 0 else
                    curses.color_pair(CP.YELLOW) | curses.A_BOLD
                    if line.startswith("  KEY") or line.startswith("  CHAT") or line.startswith("  EASY")
                    else curses.color_pair(CP.WHITE))
            self._put(row, lx, line[:bw], attr)

        self._statusbar(self.h - 2)


