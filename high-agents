#  STATE
# ═══════════════════════════════════════════════════════════════
class State:
    def __init__(self):
        self.tick          = 0
        self.start_t       = time.monotonic()
        # live metrics (simulated; replaced by engine when available)
        self.phi           = 0.680
        self.q_val         = 0.724
        self.d_val         = 0.451
        self.v_val         = 4.83
        self.regime_idx    = 3   # "Balanced"
        self.regime        = REGIMES[self.regime_idx][0]
        self.phi_history   = deque([0.680] * CONFIG["sparkline_len"],
                                    maxlen=CONFIG["sparkline_len"])
        # activity log
        self.log           = deque(maxlen=CONFIG["log_capacity"])
        self.log_scroll    = 0
        # chat history  [(speaker, text), ...]  speaker = "you" | "ai"
        self.chat          = deque(maxlen=CONFIG["chat_history"])
        self.chat_input    = ""
        # agent animation phases
        self.agent_angle   = [random.random() * math.tau for _ in AGENTS]
        # matrix rain state  {col: [head_row, trail_len, speed, acc]}
        self.matrix        = {}
        # timing
        self.last_log_t    = 0.0
        self.last_regime_t = 0.0
        self.wave_phase    = 0.0
        # ui flags
        self.paused        = False
        self.view          = "dash"   # "dash" | "chat" | "help"

        # seed log
        for _ in range(8):
            k, m = random.choice(LOG_EVENTS)
            self.log.appendleft((datetime.now().strftime("%H:%M:%S"), k, m))
        # seed chat
        self.chat.append(("ai",
            f"[{APP_NAME}] Online.  Skill: Codebase Analysis Engine · "
            "Adaptive Regime Optimization · Storm Swarm AIOS.  "
            "Type a question (phi / q / d / v / regime / swarm / help)."))

    # ── properties ─────────────────────────────────────────────
    @property
    def uptime(self):
        s = int(time.monotonic() - self.start_t)
        h, m = divmod(s, 3600)
        m, s = divmod(m, 60)
        return f"{h:02d}:{m:02d}:{s:02d}"

    @property
    def regime_coeffs(self):
        return REGIMES[self.regime_idx][1:]   # (α₁, α₂, α₃)

    # ── per-frame update ────────────────────────────────────────
    def update(self):
        if self.paused:
            return
        now = time.monotonic()
        self.tick += 1

        sp = CONFIG["metric_drift"]
        self.phi   = max(0.01, min(0.99, self.phi   + random.gauss(0, sp)))
        self.q_val = max(0.01, min(0.99, self.q_val + random.gauss(0, sp)))
        self.d_val = max(0.01, min(0.99, self.d_val + random.gauss(0, sp)))
        self.v_val = max(1.0,  min(20.0, self.v_val + random.gauss(0, sp * 5)))
        self.phi_history.append(self.phi)

        for i in range(len(AGENTS)):
            self.agent_angle[i] = (
                self.agent_angle[i] + CONFIG["spinner_speed"]) % math.tau

        self.wave_phase += CONFIG["wave_speed"]

        if now - self.last_log_t >= CONFIG["log_interval"]:
            self.last_log_t = now
            k, m = random.choice(LOG_EVENTS)
            self.log.appendleft((datetime.now().strftime("%H:%M:%S"), k, m))

        if now - self.last_regime_t >= CONFIG["regime_interval"]:
            self.last_regime_t = now
            old = self.regime
            self.regime_idx = (self.regime_idx + 1) % len(REGIMES)
            self.regime = REGIMES[self.regime_idx][0]
            msg = f"Regime: {old} → {self.regime}"
            self.log.appendleft((datetime.now().strftime("%H:%M:%S"), "OK", msg))

    def next_regime(self):
        old = self.regime
        self.regime_idx = (self.regime_idx + 1) % len(REGIMES)
        self.regime = REGIMES[self.regime_idx][0]
        self.last_regime_t = time.monotonic()
        self.log.appendleft((
            datetime.now().strftime("%H:%M:%S"), "OK",
            f"[manual] {old} → {self.regime}"))

    def send_chat(self):
        msg = self.chat_input.strip()
        if not msg:
            return
        self.chat.append(("you", msg))
        reply = _chat_respond(msg, self)
        self.chat.append(("ai", reply))
        self.log.appendleft((
            datetime.now().strftime("%H:%M:%S"), "INFO",
            f"Chat: {msg[:40]}"))
        self.chat_input = ""


