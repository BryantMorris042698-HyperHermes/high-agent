def _chat_respond(msg: str, state) -> str:
    """Return a chat response. Uses high_agent_engine when available."""
    msg_l = msg.strip().lower()

    if _ENGINE_AVAILABLE:
        try:
            g = DirectedGraph()
            snap = g.snapshot()
            if "phi" in msg_l:
                return f"Live Φ(G) = {snap.phi:+.4f}  Q={snap.q:.3f}  D={snap.coupling:.3f}  V={snap.mean_cyclomatic:.1f}  Regime: {snap.regime.name}"
            if "q" == msg_l or "modularity" in msg_l:
                return f"Q(G) = {snap.q:.4f}  (target > 0.70)"
        except Exception as e:
            pass  # fall through to KB

    # keyword search through built-in knowledge base
    for kw, ans in _CHAT_KB.items():
        if kw in msg_l:
            return ans

    # dynamic metric echo
    if any(w in msg_l for w in ("status", "metrics", "stats")):
        return (f"Φ(G)={state.phi:.4f}  Q={state.q_val:.3f}  "
                f"D={state.d_val:.3f}  V={state.v_val:.1f}  "
                f"Regime: {state.regime}  Uptime: {state.uptime}")

    return (f"[{APP_NAME}] Skill: Codebase Analysis Engine — "
            f"ask about: phi, q, d, v, regime, agent, swarm, skill, crawl, graph. "
            f"Current Φ(G)={state.phi:.4f}  Regime={state.regime}")


